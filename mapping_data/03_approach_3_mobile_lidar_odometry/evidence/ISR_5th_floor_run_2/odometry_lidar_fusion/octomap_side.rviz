Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Odometry LiDAR fused OctoMap
      Namespaces: {}
      Queue Size: 100
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /occupied_cells_vis_array
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Recorded robot odometry
      Line Style: Lines
      Line Width: 0.08
      Buffer Length: 1
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /recorded_odom_path
      Value: true
  Enabled: true
  Global Options:
    Background Color: 15; 15; 18
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 70
      Focal Point: {X: 0, Y: 0, Z: 0.8}
      Name: Fused OctoMap side
      Pitch: 0.08
      Target Frame: odom
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.0
    Saved: ~
Window Geometry: {Height: 900, Width: 1600, X: 0, Y: 0}
