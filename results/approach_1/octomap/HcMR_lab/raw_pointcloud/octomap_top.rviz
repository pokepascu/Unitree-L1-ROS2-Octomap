Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.6
      Name: LiDAR axes
      Radius: 0.025
      Reference Frame: unilidar_lidar
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Occupied OctoMap Voxels
      Namespaces: {}
      Queue Size: 100
      Topic: {Depth: 1, Durability Policy: Transient Local, History Policy: Keep Last, Reliability Policy: Reliable, Value: /occupied_cells_vis_array}
      Value: true
  Enabled: true
  Global Options: {Background Color: 15; 15; 18, Fixed Frame: unilidar_lidar, Frame Rate: 30}
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 28
      Focal Point: {X: 0, Y: 0, Z: 0}
      Name: Fitted top evidence
      Pitch: 1.55
      Target Frame: unilidar_lidar
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.0
    Saved: ~
Window Geometry: {Height: 900, Width: 1600, X: 0, Y: 0}
